{
 "manifest_version":3,"name":"ScrollShot — Capture & Edit","version":"2.0.1",
 "description":"Capture full pages, visible areas or selections. Annotate, copy and export locally.",
 "minimum_chrome_version":"116",
 "permissions":["activeTab","scripting","clipboardWrite","offscreen","storage"],
 "background":{"service_worker":"background.js","type":"module"},
 "action":{"default_popup":"popup.html","default_title":"ScrollShot"},
 "commands":{"capture-full":{"suggested_key":{"default":"Alt+Shift+S"},"description":"Capture full page"}}
}
